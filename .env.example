# Copy this file to .env.local and fill in your values.

# Neon Postgres connection string (Dashboard → your project → Connect).
# Use the "pooled" connection string; it looks like:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Secret used to sign user session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin panel (optional overrides; sensible dev defaults exist in code).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# UploadThing token for admin media uploads.
UPLOADTHING_TOKEN=
RESEND_API_KEY=
EMAIL_FROM="Bandhan Tours <bookings@yourdomain.com>"

# Canonical production URL, used for sitemap.xml, robots.txt, and OG/canonical tags.
NEXT_PUBLIC_SITE_URL=https://www.bandhantours.com
